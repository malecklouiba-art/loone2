{
  "name": "loone-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Loone AI — Voice-First CRM (monorepo)",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "pnpm --filter @loone/mobile start",
    "mobile:ios": "pnpm --filter @loone/mobile ios",
    "mobile:android": "pnpm --filter @loone/mobile android",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --linked > packages/shared/src/database.types.ts",
    "functions:serve": "supabase functions serve",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20"
  }
}
