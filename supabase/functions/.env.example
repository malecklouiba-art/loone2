# Secrets des Edge Functions (jamais exposés au client mobile).
# En prod : `supabase secrets set KEY=value`
# En local : ces variables sont chargées par `supabase functions serve --env-file`.

# IA — cerveau (Anthropic Claude, tool use)
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# IA — transcription (OpenAI Whisper)
OPENAI_API_KEY=sk-xxx
OPENAI_STT_MODEL=whisper-1

# Emails
RESEND_API_KEY=re_xxx

# Fournis automatiquement par la plateforme Supabase au runtime :
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
